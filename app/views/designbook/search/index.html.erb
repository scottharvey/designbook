<% content_for :title, "Search" %>

<article class="db-article">
  <header class="db-article-header">
    <h1>Search</h1>
    <% if active_search?(query) %>
      <p class="db-article-lede">Showing results for <strong><%= query %></strong>.</p>
    <% else %>
      <p class="db-article-lede">Use the command palette (⌘K) or type a query to find pages.</p>
    <% end %>
  </header>

  <% if active_search?(query) && grouped_results.empty? %>
    <div class="db-empty-state">
      <p>No pages matched that query.</p>
      <button type="button" class="db-button" data-db-open-palette>Try the command palette</button>
    </div>
  <% end %>

  <% grouped_results.each do |section, results| %>
    <section class="db-search-section">
      <h2><%= section_title(section) %></h2>
      <ul class="db-search-results">
        <% results.each do |result| %>
          <li>
            <%= link_to result.page.title, designbook_page_path_for(result.page) %>
            <p><%= highlight_search_excerpt(result.excerpt, query) %></p>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</article>
