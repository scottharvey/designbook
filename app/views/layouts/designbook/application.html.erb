<!DOCTYPE html>
<html lang="en" data-db-theme="<%= designbook_theme_preference %>" class="<%= designbook_root_html_class %>">
<head>
  <script>
    (function () {
      var root = document.documentElement;
      root.classList.add("db-booting");

      function writeCookie(name, value) {
        document.cookie = name + "=" + encodeURIComponent(value) +
          "; path=/; max-age=31536000; SameSite=Lax";
      }

      try {
        var theme = window.localStorage.getItem("designbook:theme") || root.getAttribute("data-db-theme") || "system";
        if (theme !== "light" && theme !== "dark" && theme !== "system") theme = "system";
        root.setAttribute("data-db-theme", theme);
        writeCookie("designbook_theme", theme);

        var dark = theme === "dark" ||
          (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        root.style.colorScheme = dark ? "dark" : "light";
        root.style.backgroundColor = dark ? "#141210" : "#f7f5f1";

        var collapsed = window.localStorage.getItem("designbook:sidebar-collapsed");
        if (collapsed === null) {
          collapsed = root.classList.contains("db-sidebar-collapsed") ? "1" : "0";
        }
        root.classList.toggle("db-sidebar-collapsed", collapsed === "1");
        writeCookie("designbook_sidebar", collapsed === "1" ? "1" : "0");
        window.localStorage.setItem("designbook:sidebar-collapsed", collapsed === "1" ? "1" : "0");
        window.localStorage.setItem("designbook:theme", theme);
      } catch (_error) {}
    })();
  </script>
  <style>
    html, body { background-color: #f7f5f1; }
    html[data-db-theme="dark"],
    html[data-db-theme="dark"] body { background-color: #141210; }
    @media (prefers-color-scheme: dark) {
      html[data-db-theme="system"],
      html[data-db-theme="system"] body { background-color: #141210; }
    }
    html.db-booting .db-shell { transition: none !important; }
    html.db-sidebar-collapsed .db-shell {
      display: grid;
      grid-template-columns: 2.75rem minmax(0, 1fr);
      min-height: 100vh;
    }
    html.db-sidebar-collapsed .db-sidebar { display: none !important; }
    html.db-sidebar-collapsed .db-sidebar-rail,
    html.db-sidebar-collapsed .db-sidebar-rail[hidden] {
      display: flex !important;
    }
  </style>
  <title><%= content_for?(:title) ? "#{yield(:title)} · Designbook" : "Designbook" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">

  <%= yield :head %>

  <%= stylesheet_link_tag "designbook/application", media: "all" %>
  <% if defined?(Lookbook) %>
    <script src="/lookbook-assets/js/lookbook.js" defer></script>
  <% end %>
  <%= javascript_include_tag "designbook/application", defer: true %>
  <script type="application/json" id="db-search-index"><%= raw search_index_json %></script>
</head>
<body class="db-body" data-db-current-slug="<%= current_page&.slug %>">
<a class="db-skip-link" href="#db-main">Skip to content</a>

<main class="db-shell" data-db-shell>
  <aside class="db-sidebar" data-db-sidebar aria-label="Designbook navigation">
    <div class="db-sidebar-header">
      <p class="db-sidebar-title"><%= link_to "Designbook", designbook.root_path, class: "db-brand-link" %></p>
      <div class="db-sidebar-tools">
        <button
          type="button"
          class="db-icon-button db-sidebar-collapse"
          data-db-sidebar-toggle
          aria-expanded="<%= designbook_sidebar_collapsed? ? "false" : "true" %>"
          aria-label="<%= designbook_sidebar_collapsed? ? "Show navigation" : "Hide navigation" %>"
          title="<%= designbook_sidebar_collapsed? ? "Show navigation" : "Hide navigation" %>"
        >
          <svg class="db-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M6.5 3.5 2 8l4.5 4.5M2.5 8h11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    <button type="button" class="db-command-trigger" data-db-open-palette>
      <span>Search pages…</span>
      <kbd>⌘K</kbd>
    </button>

    <nav class="db-sidebar-nav" data-db-nav aria-label="Sections">
      <% catalog.section_tree.reject { |section, _pages| section == "help" }.each do |section, pages| %>
        <% expanded = nav_section_expanded?(section) %>
        <section class="db-nav-section<%= expanded ? " is-expanded" : "" %>" data-db-nav-section="<%= section %>" data-expanded="<%= expanded %>">
          <button
            type="button"
            class="db-nav-heading"
            data-db-nav-toggle
            aria-expanded="<%= expanded %>"
            aria-controls="db-nav-<%= section %>"
          >
            <span><%= section_title(section) %></span>
            <span class="db-nav-chevron" aria-hidden="true"></span>
          </button>
          <ul class="db-nav-list" id="db-nav-<%= section %>" <%= expanded ? "" : "hidden" %>>
            <% pages.each do |page| %>
              <li>
                <%= link_to page.title,
                            designbook_page_path_for(page),
                            class: "db-nav-link#{page == current_page ? " is-active" : ""}",
                            data: { db_nav_link: true, slug: page.slug },
                            aria: { current: (page == current_page ? "page" : nil) } %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </nav>

    <div class="db-sidebar-help">
      <% help_page = catalog.page_for_slug("help") %>
      <% if help_page %>
        <p>
          <%= link_to "How to use Designbook",
                      designbook_page_path_for(help_page),
                      class: "db-sidebar-help-link#{current_page&.slug == help_page.slug ? " is-active" : ""}" %>
        </p>
      <% end %>
      <p>
        <button type="button" class="db-sidebar-help-link db-sidebar-theme" data-db-theme-toggle aria-label="Theme: <%= designbook_theme_preference %>">
          Theme
        </button>
      </p>
    </div>
  </aside>

  <div class="db-sidebar-rail" data-db-sidebar-rail <%= designbook_sidebar_collapsed? ? "" : "hidden" %>>
    <button
      type="button"
      class="db-icon-button db-sidebar-expand"
      data-db-sidebar-expand
      aria-label="Show navigation"
      title="Show navigation"
    >
      <svg class="db-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M2 3.25h12M2 8h12M2 12.75h12M5.25 3.25v9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <section class="db-content" id="db-main" tabindex="-1">
    <%= yield %>
  </section>
</main>

<div class="db-palette" data-db-palette hidden>
  <div class="db-palette-backdrop" data-db-palette-close></div>
  <div class="db-palette-dialog" role="dialog" aria-modal="true" aria-label="Command palette">
    <div class="db-palette-input-wrap">
      <input
        type="search"
        class="db-palette-input"
        data-db-palette-input
        placeholder="Search pages…"
        autocomplete="off"
        spellcheck="false"
        aria-controls="db-palette-results"
      >
    </div>
    <div class="db-palette-section-label" data-db-palette-label>Recent</div>
    <ul class="db-palette-results" id="db-palette-results" data-db-palette-results role="listbox"></ul>
    <p class="db-palette-empty" data-db-palette-empty hidden>No matching pages.</p>
  </div>
</div>
</body>
</html>
