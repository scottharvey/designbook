# Bundler
/.bundle/
/vendor/bundle
/vendor/cache

# Ruby / gem build artifacts
/*.gem
/pkg/
/doc/
/.yardoc/
/_yardoc/
/rdoc/

# Test / coverage
/coverage/
/.rspec_status
/spec/reports/
/test/reports/
/tmp/
/log/
*.log

# Dummy app runtime
/spec/dummy/log/*
/spec/dummy/tmp/*
/spec/dummy/storage/*
/spec/dummy/db/*.sqlite3
/spec/dummy/db/*.sqlite3-*
/spec/dummy/public/assets/
/spec/dummy/public/packs/
/spec/dummy/public/packs-test/
/spec/dummy/node_modules/
