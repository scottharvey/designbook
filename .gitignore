!/spec/dummy/tmp/.keep
!/spec/dummy/tmp/pids/.keep
!/spec/dummy/storage/.keep

# Rails / assets
/public/assets/
/node_modules/
/yarn-error.log
/yarn-debug.log*
.yarn-integrity
/npm-debug.log*

# Env / secrets
.env
.env.*
!.env.example
*.key
/config/master.key
/spec/dummy/config/master.key
/spec/dummy/config/credentials/*.key

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*~
.byebug_history
.irb_history
.ruby-gemset

